root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.mdx]
indent_size = unset
trim_trailing_whitespace = false

# nixosOptionsDoc owns list indentation in this generated CommonMark document.
[site/src/content/docs/reference/options-generated.md]
indent_size = unset
